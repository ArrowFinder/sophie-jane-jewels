# Shopify Storefront API — the commerce source of truth.
# When these are set, the site uses live Shopify data instead of the sample catalog.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Prefer the private token from the Headless sales channel (server-side only).
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Or the public Storefront token (either one is enough).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional: POST /api/revalidate?secret=... to refresh product/collection cache.
SHOPIFY_REVALIDATION_SECRET=

# Absolute production URL — used for canonical tags, sitemap, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.sophiejanejewels.com
